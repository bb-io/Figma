<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Product>Figma</Product>
        <Description>Design and collaboration platform that specializes in UI and UX design</Description>
        <Version>1.0.13</Version>
        <AssemblyName>Apps.Figma</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Blackbird.Applications.SDK.Blueprints" Version="1.0.2" />
        <PackageReference Include="Blackbird.Applications.Sdk.Common" Version="2.17.0" />
        <PackageReference Include="Blackbird.Applications.SDK.Extensions.FileManagement" Version="1.1.0" />
        <PackageReference Include="Blackbird.Applications.Sdk.Utils" Version="1.1.0-rc.8709" />
        <PackageReference Include="Blackbird.Filters" Version="1.3.5" />
        <PackageReference Include="MimeTypes" Version="2.4.1" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource CopyToOutputDirectory="Always" Include="image\icon.png" />
        <EmbeddedResource CopyToOutputDirectory="Always" Include="..\README.md" Link="README.md" />
    </ItemGroup>

</Project>
